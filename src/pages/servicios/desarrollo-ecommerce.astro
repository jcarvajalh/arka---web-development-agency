---
// Servicio .03 — Desarrollo de E-commerce
// Composición: titular a ancho completo + imagen panorámica · franja de integraciones ·
// problema/solución en paralelo · bento grid · fases en tarjetas con progreso · FAQ split
import BaseLayout from "../../layouts/BaseLayout.astro";
import Breadcrumb from "../../components/servicios/Breadcrumb.astro";
import ServiceCTA from "../../components/servicios/ServiceCTA.astro";
import ServiceFAQ from "../../components/servicios/ServiceFAQ.astro";
import ServiceSchema from "../../components/servicios/ServiceSchema.astro";
import OtrosServicios from "../../components/servicios/OtrosServicios.astro";
import { getServicio } from "../../data/servicios";

const s = getServicio("desarrollo-ecommerce");
const integraciones = [
  "Shopify",
  "Wompi",
  "Mercado Pago",
  "PayU",
  "Facturación electrónica",
  "Inventario",
  "Operadores logísticos",
  "Google Analytics 4",
];
---

<BaseLayout title={s.metaTitle} description={s.metaDescription} image={s.image}>
  <ServiceSchema servicio={s} />

  <article class="eco bg-[#0a0a0a] text-white">
    <!-- ── Hero ── -->
    <header class="max-w-[1200px] mx-auto px-6 pt-32 md:pt-40 pb-14">
      <Breadcrumb nombre={s.nombre} />
      <div class="grid lg:grid-cols-[1.5fr_1fr] gap-10 items-end">
        <div>
          <p class="eco__eyebrow">
            <span class="eco__pill">.03</span>
            {s.eyebrow}
          </p>
          <h1 class="eco__h1">{s.h1}</h1>
        </div>
        <div>
          <p class="text-[#9b9b9b] text-[16px] leading-[1.7] mb-8">{s.intro}</p>
          <ServiceCTA />
        </div>
      </div>
    </header>

    <div class="max-w-[1200px] mx-auto px-6">
      <figure class="eco__hero-img">
        <img
          src={s.image}
          alt={s.imageAlt}
          width="1200"
          height="500"
          loading="eager"
        />
        <figcaption class="eco__badge" aria-hidden="true">
          <span class="eco__badge-dot"></span> Nuevo pedido · $ 289.900
        </figcaption>
      </figure>
    </div>

    <!-- ── Integraciones ── -->
    <div class="eco__marquee" aria-label="Integraciones disponibles">
      <ul class="eco__track" role="list">
        {
          [...integraciones, ...integraciones].map((x, i) => (
            <li aria-hidden={i >= integraciones.length ? "true" : undefined}>{x}</li>
          ))
        }
      </ul>
    </div>

    <!-- ── Problema / Solución ── -->
    <section class="max-w-[1200px] mx-auto px-6 py-28" aria-labelledby="eco-problema">
      <div class="grid lg:grid-cols-2 gap-14 lg:gap-20">
        <div>
          <p class="section-label">El problema</p>
          <h2 id="eco-problema" class="eco__h2">{s.problemaTitulo}</h2>
          <p class="text-[#9a9a9a] leading-[1.8] mb-8">{s.problema}</p>
          <div class="eco__cart eco__cart--bad">
            <p class="eco__cart-head">Carrito abandonado</p>
            {s.sintomas.map((x) => <p class="eco__cart-row">{x}</p>)}
          </div>
        </div>
        <div class="lg:pt-24">
          <p class="section-label">La solución</p>
          <h2 class="eco__h2">{s.solucionTitulo}</h2>
          <p class="text-[#b9b9b9] leading-[1.8] mb-8">{s.solucion}</p>
          <div class="eco__cart eco__cart--good">
            <p class="eco__cart-head">Compra completada</p>
            <p class="eco__cart-row">Carga rápida y fichas claras</p>
            <p class="eco__cart-row">Checkout en pocos pasos</p>
            <p class="eco__cart-row">Pagos locales confiables</p>
            <p class="eco__cart-row">Pedido sincronizado con inventario</p>
          </div>
        </div>
      </div>
    </section>

    <!-- ── Qué incluye: bento ── -->
    <section class="max-w-[1200px] mx-auto px-6 pb-28" aria-labelledby="eco-incluye">
      <div class="text-center mb-12">
        <p class="section-label">Qué incluye</p>
        <h2 id="eco-incluye" class="eco__h2 mx-auto max-w-[22ch]">
          Tu tienda online personalizada, de punta a punta
        </h2>
      </div>
      <ul class="eco__bento" role="list">
        {
          s.incluye.map((item, i) => (
            <li class={`eco__bento-${i}`}>
              <span class="eco__bento-n">{String(i + 1).padStart(2, "0")}</span>
              <h3>{item.title}</h3>
              <p>{item.description}</p>
            </li>
          ))
        }
      </ul>
    </section>

    <!-- ── Fases ── -->
    <section class="eco__phases" aria-labelledby="eco-fases">
      <div class="max-w-[1200px] mx-auto px-6">
        <div class="flex flex-wrap items-end justify-between gap-8 mb-12">
          <div>
            <p class="section-label">Cómo lo hacemos</p>
            <h2 id="eco-fases" class="eco__h2 !mb-0">Del catálogo a la primera venta</h2>
          </div>
          <ServiceCTA />
        </div>
        <ol class="eco__cards" role="list">
          {
            s.fases.map((f, i) => (
              <li style={`--p:${(i + 1) * 25}%`}>
                <div class="eco__card-top">
                  <span>Paso {i + 1} de 4</span>
                  <span>{(i + 1) * 25}%</span>
                </div>
                <div class="eco__bar" aria-hidden="true"><i /></div>
                <h3>{f.title}</h3>
                <p>{f.description}</p>
              </li>
            ))
          }
        </ol>
      </div>
    </section>

    <!-- ── FAQ ── -->
    <div class="max-w-[1200px] mx-auto px-6 py-28">
      <ServiceFAQ faqs={s.faqs} titulo="Preguntas frecuentes sobre e-commerce" />
    </div>

    <div class="max-w-[1200px] mx-auto px-6 pb-24">
      <ServiceCTA
        variant="band"
        titulo="Hagamos que tu tienda venda más"
        texto="Cuéntanos sobre tu catálogo y tu operación, y te recomendamos la plataforma e integraciones adecuadas."
      />
    </div>
    <div class="max-w-[1200px] mx-auto px-6 pb-28">
      <OtrosServicios actual={s.slug} />
    </div>
  </article>
</BaseLayout>

<style>
  .eco__eyebrow {
    display: flex;
    align-items: center;
    gap: 12px;
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: #9a9a9a;
    margin: 0 0 22px;
  }
  .eco__pill {
    letter-spacing: 0;
    font-style: italic;
    color: #fff;
    background: #006aff;
    border-radius: 999px;
    padding: 3px 10px;
  }
  .eco__h1 {
    font-size: var(--fs-display);
    font-weight: 600;
    line-height: 1.05;
    letter-spacing: -0.055em;
    margin: 0;
  }
  .eco__h2 {
    font-size: clamp(26px, 3.4vw, 40px);
    font-weight: 700;
    line-height: 1.08;
    letter-spacing: -0.035em;
    margin: 0 0 18px;
  }

  .eco__hero-img {
    position: relative;
    margin: 0;
    border-radius: 24px;
    overflow: hidden;
    border: 1px solid #1e1e1e;
    aspect-ratio: 21 / 9;
  }
  .eco__hero-img img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .eco__badge {
    position: absolute;
    left: 24px;
    bottom: 24px;
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 10px 16px;
    border-radius: 999px;
    background: rgba(10, 10, 10, 0.75);
    backdrop-filter: blur(10px);
    border: 1px solid rgba(255, 255, 255, 0.1);
    font-size: 13px;
    font-weight: 600;
    animation: eco-pop 4s ease-in-out infinite;
  }
  .eco__badge-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: #22c55e;
    box-shadow: 0 0 0 4px rgba(34, 197, 94, 0.2);
  }
  @keyframes eco-pop {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(-6px); }
  }

  /* Marquee */
  .eco__marquee {
    overflow: hidden;
    border-block: 1px solid #1a1a1a;
    margin-top: 64px;
    padding: 22px 0;
    mask-image: linear-gradient(90deg, transparent, #000 10%, #000 90%, transparent);
  }
  .eco__track {
    display: flex;
    gap: 56px;
    width: max-content;
    list-style: none;
    margin: 0;
    padding: 0;
    animation: eco-scroll 32s linear infinite;
  }
  .eco__track li {
    font-size: clamp(18px, 2.2vw, 26px);
    font-weight: 700;
    letter-spacing: -0.03em;
    color: #4a4a4a;
    white-space: nowrap;
  }
  .eco__track li::after {
    content: "✦";
    margin-left: 56px;
    color: #006aff;
    font-size: 14px;
    vertical-align: middle;
  }
  @keyframes eco-scroll {
    to { transform: translateX(-50%); }
  }

  /* Carrito problema/solución */
  .eco__cart {
    border-radius: 18px;
    border: 1px solid #222;
    background: #0f0f0f;
    padding: 8px 22px;
  }
  .eco__cart-head {
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    margin: 0;
    padding: 14px 0;
    border-bottom: 1px dashed #2a2a2a;
  }
  .eco__cart--bad .eco__cart-head {
    color: #ff6b61;
  }
  .eco__cart--good {
    border-color: rgba(0, 106, 255, 0.35);
    background: #0f1218;
  }
  .eco__cart--good .eco__cart-head {
    color: #6aa8ff;
  }
  .eco__cart-row {
    margin: 0;
    padding: 14px 0 14px 30px;
    border-bottom: 1px solid #1c1c1c;
    position: relative;
    font-size: 15px;
    color: #cfcfcf;
  }
  .eco__cart-row:last-child {
    border-bottom: 0;
  }
  .eco__cart--bad .eco__cart-row {
    text-decoration: line-through;
    text-decoration-color: rgba(255, 90, 79, 0.6);
    color: #8a8a8a;
  }
  .eco__cart-row::before {
    position: absolute;
    left: 0;
    top: 14px;
    font-size: 13px;
  }
  .eco__cart--bad .eco__cart-row::before {
    content: "✕";
    color: #ff5a4f;
  }
  .eco__cart--good .eco__cart-row::before {
    content: "✓";
    color: #006aff;
    font-weight: 700;
  }

  /* Bento */
  .eco__bento {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    grid-auto-rows: minmax(200px, auto);
    gap: 12px;
  }
  .eco__bento li {
    border: 1px solid #1e1e1e;
    border-radius: 20px;
    background: #101010;
    padding: 28px;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    transition:
      border-color 0.3s ease,
      transform 0.3s ease;
  }
  .eco__bento li:hover {
    border-color: rgba(0, 106, 255, 0.45);
    transform: translateY(-3px);
  }
  .eco__bento-0 {
    grid-column: span 2;
    background:
      radial-gradient(60% 80% at 100% 0%, rgba(0, 106, 255, 0.25), transparent 70%),
      #101010 !important;
  }
  .eco__bento-3,
  .eco__bento-4 {
    grid-column: span 2;
  }
  .eco__bento-n {
    font-size: 12px;
    font-weight: 700;
    color: #006aff;
    margin-bottom: auto;
    padding-bottom: 28px;
  }
  .eco__bento h3 {
    margin: 0 0 8px;
    font-size: 20px;
    font-weight: 700;
    letter-spacing: -0.025em;
  }
  .eco__bento-0 h3 {
    font-size: clamp(24px, 2.6vw, 32px);
  }
  .eco__bento p {
    margin: 0;
    color: #8a8a8a;
    font-size: 14px;
    line-height: 1.6;
  }

  /* Fases */
  .eco__phases {
    padding: 100px 0;
    background: #0e0e0e;
    border-block: 1px solid #1a1a1a;
  }
  .eco__cards {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 12px;
  }
  .eco__cards li {
    border: 1px solid #1e1e1e;
    border-radius: 20px;
    background: #0a0a0a;
    padding: 24px;
  }
  .eco__card-top {
    display: flex;
    justify-content: space-between;
    font-size: 12px;
    color: #777;
    font-weight: 600;
  }
  .eco__bar {
    height: 4px;
    border-radius: 4px;
    background: #1e1e1e;
    margin: 12px 0 36px;
    overflow: hidden;
  }
  .eco__bar i {
    display: block;
    height: 100%;
    width: var(--p);
    background: #006aff;
    border-radius: inherit;
  }
  .eco__cards h3 {
    margin: 0 0 10px;
    font-size: 21px;
    font-weight: 700;
    letter-spacing: -0.03em;
  }
  .eco__cards p {
    margin: 0;
    color: #8f8f8f;
    font-size: 14px;
    line-height: 1.65;
  }

  @media (max-width: 1024px) {
    .eco__cards {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (max-width: 760px) {
    .eco__hero-img {
      aspect-ratio: 4 / 3;
    }
    .eco__bento {
      grid-template-columns: 1fr;
    }
    .eco__bento-0,
    .eco__bento-3,
    .eco__bento-4 {
      grid-column: auto;
    }
    .eco__badge {
      left: 14px;
      bottom: 14px;
    }
  }
  @media (max-width: 560px) {
    .eco__cards {
      grid-template-columns: 1fr;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .eco__track,
    .eco__badge {
      animation: none;
    }
  }
</style>
