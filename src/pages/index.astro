---
import BaseLayout from "../layouts/BaseLayout.astro";
import Hero from "../components/sections/Hero.astro";
import ServicesCarousel from "../components/sections/Servicios.astro";
import Proceso from "../components/sections/Proceso.astro";
import Stack from "../components/sections/Stack.astro";
import Clientes from "../components/sections/clientes.astro";
import Paquetes from "../components/sections/Precios.astro";
import FAQ from "../components/sections/FAQ.astro";

const siteUrl = "https://arka-agency.com";

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "ProfessionalService",
  "@id": `${siteUrl}/#organization`,
  name: "ARKA",
  alternateName: "ARKA Agency",
  description:
    "Agencia de desarrollo web en Cali, Colombia. Diseño y desarrollo web estratégico para empresas Tech, SaaS y clínicas de salud.",
  url: siteUrl,
  logo: `${siteUrl}/logo-arka-header.webp`,
  image: `${siteUrl}/logo-arka-header.webp`,
  email: "contacto@arka-agency.com",
  priceRange: "$$",
  knowsLanguage: ["es"],
  address: {
    "@type": "PostalAddress",
    addressLocality: "Cali",
    addressRegion: "Valle del Cauca",
    addressCountry: "CO",
  },
  areaServed: [
    { "@type": "City", name: "Cali" },
    { "@type": "Country", name: "Colombia" },
  ],
  sameAs: ["https://www.instagram.com/arka.agencyweb/"],
  hasOfferCatalog: {
    "@type": "OfferCatalog",
    name: "Servicios de desarrollo web",
    itemListElement: [
      "Webs para Startups & Tech",
      "Sitios Clínicos (Odontología y Estética)",
      "E-commerce de alto impacto",
      "SEO Y CRO",
      "IA & Automatizaciones",
    ].map((servicio) => ({
      "@type": "Offer",
      itemOffered: { "@type": "Service", name: servicio },
    })),
  },
};
---

<BaseLayout
  title="ARKA | Diseño y Desarrollo Web Estratégico a Medida"
  description="En ARKA diseñamos y desarrollamos sitios web y tiendas online a medida, optimizados para SEO, rendimiento y conversión, para impulsar tu negocio."
>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} is:inline />

  <Hero />
  <ServicesCarousel />
  <Stack />
  <Proceso />
  <Clientes />
  <Paquetes />
  <FAQ />
</BaseLayout>
