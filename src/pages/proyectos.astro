---
import BaseLayout from "../layouts/BaseLayout.astro";
import { proyectos } from "../data/proyectos";

const CAL_URL = "https://cal.com/arkaagency/reunion-acercamiento";
---

<BaseLayout
  title="Proyectos | ARKA — Agencia de Desarrollo Web en Cali"
  description="Casos de éxito de ARKA: sitios web, e-commerce y aplicaciones a medida desarrollados para empresas Tech, SaaS y clínicas en Cali, Colombia y Latinoamérica."
>
  <section class="bg-[#0a0a0a] text-white">
    <!-- Encabezado -->
    <div class="max-w-[1100px] mx-auto px-6 pt-32 md:pt-40 pb-16">
      <p class="section-label">Portafolio</p>
      <h1
        class="font-bold leading-[1.04] tracking-[-0.03em] text-[clamp(32px,4.8vw,52px)] mb-5"
      >
        Proyectos de desarrollo web a medida
      </h1>
      <p class="text-[#9b9b9b] text-[17px] leading-[1.7] max-w-[640px]">
        Casos reales de sitios web, tiendas online y aplicaciones que diseñamos
        y desarrollamos para empresas Tech, SaaS y clínicas en Cali, Colombia y
        Latinoamérica.
      </p>
    </div>

    <!-- Grid de proyectos -->
    <div class="max-w-[1100px] mx-auto px-6 pb-24">
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
        {
          proyectos.map((proyecto) => (
            <a
              href={`/proyectos/${proyecto.slug}`}
              class="group rounded-2xl overflow-hidden border border-[#1e1e1e] bg-[#111] transition-colors hover:border-[#006aff]/50"
              aria-label={`Ver caso de estudio: ${proyecto.title}`}
            >
              <div class="aspect-[16/10] overflow-hidden">
                <img
                  src={proyecto.image}
                  alt={proyecto.alt}
                  class="w-full h-full object-cover transition-transform duration-300 group-hover:scale-105"
                  width="640"
                  height="400"
                  loading="lazy"
                  decoding="async"
                />
              </div>
              <div class="p-6">
                <p class="text-[12px] text-[#666] mb-2">
                  {proyecto.category} · {proyecto.year}
                </p>
                <h2 class="text-white font-semibold text-[20px] tracking-[-0.02em] mb-2">
                  {proyecto.title}
                </h2>
                <p class="text-[#9b9b9b] text-[14px] leading-[1.6] mb-4">
                  {proyecto.summary}
                </p>
                <div class="flex flex-wrap gap-2 mb-4">
                  {proyecto.tecnologias.map((tech) => (
                    <span class="text-[11px] text-[#9b9b9b] border border-[#1e1e1e] rounded-full px-3 py-1">
                      {tech}
                    </span>
                  ))}
                </div>
                <span class="text-[#006aff] font-semibold text-sm inline-flex items-center gap-1">
                  Ver caso de estudio
                  <svg
                    width="16"
                    height="16"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  >
                    <path d="M5 12h14" />
                    <path d="m12 5 7 7-7 7" />
                  </svg>
                </span>
              </div>
            </a>
          ))
        }
      </div>
    </div>

    <!-- CTA Final -->
    <div
      class="max-w-[900px] mx-auto px-6 pb-28 text-center border-t border-[#1e1e1e] pt-16"
    >
      <h2 class="font-bold tracking-[-0.03em] text-[clamp(26px,4vw,40px)] mb-5">
        ¿Tu proyecto podría ser el próximo?
      </h2>
      <p class="text-[#888] text-[16px] leading-[1.6] max-w-[520px] mx-auto mb-8">
        Construyamos juntos una web que convierta visitantes en clientes.
      </p>
      <a href={CAL_URL} target="_blank" rel="noopener noreferrer" class="hero-btn">
        Cotiza tu proyecto
      </a>
    </div>
  </section>
</BaseLayout>
