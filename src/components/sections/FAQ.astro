---
// FAQ.astro — preguntas frecuentes de la home.
// Usa el mismo componente que las páginas de servicio (ServiceFAQ),
// así ambas FAQ comparten diseño, animaciones y schema FAQPage.
import ServiceFAQ from "../servicios/ServiceFAQ.astro";
import type { Pregunta } from "../../data/servicios";

const faqs: Pregunta[] = [
  {
    q: "¿Qué tipo de proyectos desarrolla ARKA?",
    a:
      "En ARKA diseñamos y desarrollamos sitios web corporativos, páginas para startups y empresas tecnológicas, sitios web para clínicas y tiendas online personalizadas. Trabajamos en proyectos que requieren una presencia digital profesional, experiencias de usuario cuidadas y soluciones técnicas adaptadas a los objetivos de cada negocio.",
  },
  {
    q: "¿Cuánto tiempo tarda el desarrollo de una página web?",
    a:
      "El tiempo de desarrollo depende de la complejidad del proyecto, la cantidad de páginas, las funcionalidades y la disponibilidad de contenidos. Un sitio web corporativo puede requerir algunas semanas, mientras que proyectos con integraciones o funcionalidades personalizadas pueden necesitar más tiempo. En ARKA definimos un cronograma de trabajo de acuerdo con el alcance de cada proyecto.",
  },
  {
    q: "¿ARKA trabaja con clientes fuera de Colombia?",
    a:
      "Sí. En ARKA trabajamos con empresas y clientes de Colombia y otros países. Nuestro proceso de trabajo permite gestionar proyectos de manera remota, desde las reuniones iniciales y la definición del diseño hasta el desarrollo, las revisiones y la publicación del sitio web.",
  },
  {
    q: "¿Qué incluye el precio de un proyecto de desarrollo web?",
    a:
      "El precio depende del alcance y los requerimientos de cada proyecto. Generalmente contempla la planificación, diseño de interfaz, desarrollo, adaptación a dispositivos móviles, optimización técnica y publicación del sitio web. También podemos incluir configuración de herramientas de analítica y optimización SEO inicial. Los servicios adicionales, como alojamiento, dominios o mantenimiento, se especifican en la propuesta comercial.",
  },
  {
    q: "¿Recibo el código fuente y la propiedad de mi página web?",
    a:
      "Sí. Una vez cumplidas las condiciones del proyecto, el cliente recibe los entregables acordados y los accesos correspondientes a su sitio web. Cuando el proyecto contempla código fuente personalizado, también se entrega el repositorio y el código desarrollado, de acuerdo con las condiciones de propiedad intelectual establecidas en el contrato. Buscamos que cada cliente tenga control sobre sus activos digitales.",
  },
  {
    q: "¿Ofrecen mantenimiento y soporte después de entregar el proyecto?",
    a:
      "Sí. En ARKA podemos ofrecer servicios de mantenimiento y soporte después de publicar el sitio web. Estos pueden incluir actualizaciones, corrección de errores, ajustes de contenido, mejoras de rendimiento y nuevas funcionalidades. El alcance y la periodicidad del servicio se definen según las necesidades del cliente y el tipo de proyecto.",
  },
];
---

<div class="faq-section py-20">
  <div class="max-w-[1200px] mx-auto px-[clamp(24px,6vw,80px)]">
    <ServiceFAQ
      id="faq"
      faqs={faqs}
      titulo="Resolvemos todas tus&nbsp;dudas aquí"
      cta
    />
  </div>
</div>
