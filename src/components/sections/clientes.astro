---
// clientes.astro — Proyectos Destacados
import { proyectos, type Proyecto } from "../../data/proyectos";

interface Props {
  projects?: Proyecto[];
}

const { projects = proyectos } = Astro.props;
---

<section id="proyectos" class="proyectos-section py-20">
  <div class="max-w-[1260px] mx-auto px-6">
    <!-- Header -->
    <div class="mb-14 text-center">
      <p class="section-label">Proyectos Destacados</p>
      <h2 class="proyectos-titulo mb-[18px]">
        Resultados que hablan por sí solos
      </h2>
      <p class="proyectos-sub mx-auto">
        Algunos de los sitios web que hemos transformado en herramientas de
        ventas efectivas.
      </p>
    </div>

    <!-- Grid -->
    <div class="flex justify-center">
      <div
        class={projects.length === 1
          ? "flex justify-center"
          : "proyectos-grid grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-[6px] max-w-[780px] w-full"}
      >
        {
          projects.map((proyecto) => (
            <a
              href={`/proyectos/${proyecto.slug}`}
              class="proyecto-card w-full"
              aria-label={`Ver caso de estudio: ${proyecto.title}`}
            >
              <div class="proyecto-card__imagen-wrapper">
                <img
                  src={proyecto.image}
                  alt={proyecto.alt}
                  class="proyecto-card__imagen"
                  loading="lazy"
                  decoding="async"
                  width="480"
                  height="320"
                />
                <div class="proyecto-card__overlay" />
              </div>
            </a>
          ))
        }
      </div>
    </div>
  </div>
</section>
