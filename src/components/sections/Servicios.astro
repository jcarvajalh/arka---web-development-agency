---
// Servicios.astro
// Lista editorial de servicios: número + título grande + resumen + flecha.
// Cada fila enlaza a /servicios/[slug].
import { servicios } from "../../data/servicios";
---

<section id="servicios" class="svl">
  <div class="svl__inner">
    <div class="svl__head">
      <p class="svl__label">
        <span class="svl__slash" aria-hidden="true"></span>
        Tres disciplinas, un solo equipo
      </p>
      <h2 class="svl__title"><b>Nuestros Servicios</b> — Diseño, SEO y e-commerce</h2>
    </div>

    <ul class="svl__list" role="list">
      {
        servicios.map((s, i) => (
          <li>
            <a
              href={`/servicios/${s.slug}`}
              class="svl__row"
              data-svl-row={i}
            >
              <span class="svl__num">
                .{String(i + 1).padStart(2, "0")} /
              </span>
              <h3 class="svl__name">{s.nombre}</h3>
              <p class="svl__desc">{s.resumen}</p>
              <span class="svl__arrow" aria-hidden="true">
                <svg
                  width="22"
                  height="22"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2.6"
                  stroke-linecap="square"
                >
                  <path d="M7 17 17 7M8 7h9v9" />
                </svg>
              </span>
            </a>
          </li>
        ))
      }
    </ul>
  </div>

</section>

<style>
  .svl {
    background: #0a0a0a;
    padding: 104px 0 120px;
    overflow: hidden;
  }

  .svl__inner {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 clamp(24px, 6vw, 80px);
  }

  .svl__head {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: 24px;
    padding-bottom: 28px;
    border-bottom: 1px solid #262626;
  }

  .svl__label {
    display: flex;
    align-items: center;
    gap: 14px;
    margin: 0;
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.24em;
    text-transform: uppercase;
    color: #9a9a9a;
  }

  .svl__slash {
    width: 26px;
    height: 2px;
    background: #006aff;
    transform: rotate(-22deg);
  }

  .svl__title {
    margin: 0;
    font-size: clamp(14px, 1.4vw, 16px);
    font-weight: 500;
    color: #6b6b6b;
    letter-spacing: 0;
  }
  .svl__title b {
    color: #fff;
    font-weight: 600;
  }

  .svl__list {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .svl__row {
    position: relative;
    display: grid;
    grid-template-columns: 72px 1fr minmax(0, 320px) 40px;
    align-items: center;
    gap: 24px;
    padding: clamp(28px, 4vw, 48px) 0;
    border-bottom: 1px solid #262626;
    color: #fff;
    text-decoration: none;
    isolation: isolate;
  }

  /* barrido azul inferior al hover */
  .svl__row::after {
    content: "";
    position: absolute;
    left: 0;
    bottom: -1px;
    height: 1px;
    width: 100%;
    background: #006aff;
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.6s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .svl__num {
    font-size: 14px;
    font-weight: 700;
    font-style: italic;
    color: #8a8a8a;
    transition: color 0.3s ease;
  }

  .svl__name {
    margin: 0;
    font-size: var(--fs-display);
    font-weight: 600;
    line-height: 1.05;
    letter-spacing: -0.045em;
    transition:
      transform 0.5s cubic-bezier(0.22, 1, 0.36, 1),
      color 0.3s ease;
  }

  .svl__desc {
    margin: 0;
    font-size: 14px;
    line-height: 1.6;
    color: #8f8f8f;
    transition: color 0.3s ease;
  }

  .svl__arrow {
    justify-self: end;
    display: grid;
    place-items: center;
    color: #fff;
    transition:
      transform 0.45s cubic-bezier(0.22, 1, 0.36, 1),
      color 0.3s ease;
  }

  /* Atenuar las filas no activas cuando la lista tiene hover */
  @media (hover: hover) {
    .svl__list:hover .svl__row:not(:hover) .svl__name {
      color: #3a3a3a;
    }
    .svl__row:hover::after {
      transform: scaleX(1);
    }
    .svl__row:hover .svl__name {
      transform: translateX(14px);
      font-style: italic;
    }
    .svl__row:hover .svl__num,
    .svl__row:hover .svl__arrow {
      color: #006aff;
    }
    .svl__row:hover .svl__desc {
      color: #d0d0d0;
    }
    .svl__row:hover .svl__arrow {
      transform: rotate(45deg);
    }
  }

  .svl__row:focus-visible {
    outline: 2px solid #006aff;
    outline-offset: 4px;
  }

  /* Tablet */
  @media (max-width: 900px) {
    .svl__row {
      grid-template-columns: 56px 1fr 32px;
      row-gap: 10px;
    }
    .svl__desc {
      grid-column: 2 / 3;
      grid-row: 2;
    }
    .svl__arrow {
      grid-column: 3;
      grid-row: 1;
    }
  }

  /* Mobile */
  @media (max-width: 560px) {
    .svl {
      padding: 72px 0 80px;
    }
    .svl__row {
      grid-template-columns: 1fr 28px;
      gap: 8px;
    }
    .svl__num {
      grid-column: 1;
      grid-row: 1;
      font-size: 12px;
    }
    .svl__name {
      grid-column: 1;
      grid-row: 2;
    }
    .svl__desc {
      grid-column: 1;
      grid-row: 3;
      font-size: 13px;
    }
    .svl__arrow {
      grid-column: 2;
      grid-row: 1 / 3;
      align-self: center;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .svl__row::after,
    .svl__name,
    .svl__arrow {
      transition: none;
    }
  }
</style>
